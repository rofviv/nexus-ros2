<?xml version="1.0"?>
<robot name="JPAC2" xmlns:xacro="http://www.ros.org/wiki/xacro">


  <!-- Ruta a stl -->
  <xacro:arg name="meshes_path" default="package://robot_description/meshes/visual"/>
  <xacro:property name="meshes_path" value="$(arg meshes_path)"/>



  <!-- ====================== BASE ====================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 -232.53" rpy="0 0 0"/>
      <mass value="17.0"/>
      <inertia ixx="0.07105" ixy="0.0" ixz="0.0" iyy="0.11105" iyz="0.0" izz="0.16250"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${meshes_path}/base_link.STL"/></geometry>
      <material name=""><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${meshes_path}/base_link.STL"/></geometry>
    </collision>
  </link>

  <link name="BaseGiratoria1_Link">
    <inertial>
      <origin xyz="-0.019499 0.066863 6.1062E-16" rpy="0 0 0"/>
      <mass value="0.077823"/>
      <inertia ixx="8.2437E-05" ixy="-2.9935E-05" ixz="-1.927E-20" iyy="4.9106E-05" iyz="-8.3327E-20" izz="9.5967E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${meshes_path}/BaseGiratoria1_Link.STL"/></geometry>
      <material name=""><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${meshes_path}/BaseGiratoria1_Link.STL"/></geometry>
    </collision>
  </link>

  <joint name="BaseGiratoria1_join" type="continuous">
    <origin xyz="-0.0010727 -0.151 -0.02173" rpy="3.1416 0 -0.0087266"/>
    <parent link="base_link"/>
    <child link="BaseGiratoria1_Link"/>
    <axis xyz="0 0 -1"/>
    <limit effort="100" velocity="100"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="Ruedita1_Link">
    <inertial>
      <origin xyz="-5.3776E-16 6.9389E-16 1.1102E-15" rpy="0 0 0"/>
      <mass value="0.18473"/>
      <inertia ixx="0.00013393" ixy="1.6941E-20" ixz="1.135E-19" iyy="0.00013393" iyz="-1.5638E-19" izz="0.00025301"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${meshes_path}/Ruedita1_Link.STL"/></geometry>
      <material name=""><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${meshes_path}/Ruedita1_Link.STL"/></geometry>
    </collision>
  </link>

  <joint name="Ruedita1_join" type="continuous">
    <origin xyz="-0.00024393 0.037257 0.06718" rpy="-1.5708 0 -1.5708"/>
    <parent link="BaseGiratoria1_Link"/>
    <child link="Ruedita1_Link"/>
    <axis xyz="-0.006547 0 0.99998"/>
    <limit effort="100" velocity="100"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="BaseGiratoria2_Link">
    <inertial>
      <origin xyz="-0.019499 0.066863 -6.1617E-15" rpy="0 0 0"/>
      <mass value="0.077823"/>
      <inertia ixx="8.2437E-05" ixy="-2.9935E-05" ixz="-4.863E-19" iyy="4.9106E-05" iyz="-1.109E-18" izz="9.5967E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${meshes_path}/BaseGiratoria2_Link.STL"/></geometry>
      <material name=""><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${meshes_path}/BaseGiratoria2_Link.STL"/></geometry>
    </collision>
  </link>

  <joint name="BaseGiratoria2_join" type="continuous">
    <origin xyz="0.0015627 0.15099 -0.02173" rpy="-3.1416 0 3.1329"/>
    <parent link="base_link"/>
    <child link="BaseGiratoria2_Link"/>
    <axis xyz="0 0 -1"/>
    <limit effort="100" velocity="100"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="Ruedita2_Link">
    <inertial>
      <origin xyz="0 -3.7956E-15 5.2736E-15" rpy="0 0 0"/>
      <mass value="0.18473"/>
      <inertia ixx="0.00013393" ixy="8.4703E-22" ixz="-3.1324E-19" iyy="0.00013393" iyz="1.6439E-19" izz="0.00025301"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${meshes_path}/Ruedita2_Link.STL"/></geometry>
      <material name=""><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${meshes_path}/Ruedita2_Link.STL"/></geometry>
    </collision>
  </link>

  <joint name="Ruedita2_join" type="continuous">
    <origin xyz="0.00010817 0.037258 0.06718" rpy="-1.5708 0 -1.5708"/>
    <parent link="BaseGiratoria2_Link"/>
    <child link="Ruedita2_Link"/>
    <axis xyz="-0.0029034 0 -1"/>
  </joint>

  <link name="RuedaDerecha_Link">
    <inertial>
      <origin xyz="5.0238E-15 -0.038139 -6.8834E-15" rpy="0 0 0"/>
      <mass value="3.6915"/>
      <inertia ixx="0.016926" ixy="-1.7711E-16" ixz="1.8518E-16" iyy="0.030842" iyz="-1.4976E-17" izz="0.016926"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${meshes_path}/RuedaDerecha_Link.STL"/></geometry>
      <material name=""><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${meshes_path}/RuedaDerecha_Link.STL"/></geometry>
    </collision>
  </link>

  <joint name="RuedaDerecha_join" type="continuous">
    <origin xyz="0.24575 -0.0021388 -0.016" rpy="1.5708 0 1.5621"/>
    <parent link="base_link"/>
    <child link="RuedaDerecha_Link"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="100"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="RuedaIzquierda_Link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${meshes_path}/RuedaIzquierda_Link.STL"/></geometry>
      <material name=""><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${meshes_path}/RuedaIzquierda_Link.STL"/></geometry>
    </collision>
  </link>

  <joint name="RuedaIzquierda_join" type="continuous">
    <origin xyz="-0.24575 0.0021388 -0.016" rpy="1.5707963267949 0 -1.57952297305487"/>
    <parent link="base_link"/>
    <child link="RuedaIzquierda_Link"/>
    <axis xyz="0 0 -1"/>
    <limit effort="100" velocity="100"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>








  <!-- ======================= LIDAR 4D – COMPLETO ======================= -->
  <!-- Altura física aproximada del “cuerpo” del lidar (para subir el frame óptico a la tapa) -->
  <xacro:property name="lidar3d_height" value="0.04"/>  <!-- 4 cm; ajusta a tu modelo -->


  <!-- Carcasa / cuerpo del lidar -->
  <link name="lidar3d_link">
    <!-- (opcional) añade visual para ver el “cuerpo” en RViz/Gazebo -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Cilindro de ejemplo del cuerpo del sensor -->
        <cylinder radius="0.025" length="${lidar3d_height}"/>
      </geometry>
      <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="${lidar3d_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>






  <!-- Posición e INCLINACIÓN LIDAR RESPECTO AL ROBOT      90 grados --> 
  <!-- rpy está en RADIANES: (roll, pitch, yaw) -->
  <joint name="lidar3d_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar3d_link"/>
    <origin xyz="0 -0.28 0.74" rpy="1.5708 0 0"/> 
  </joint>


  <!-- Frame óptico en la PARTE SUPERIOR del cuerpo del lidar.
      El sensor “nace” aquí, así que no escaneará desde el centro sino desde la tapa. -->
  <link name="lidar3d_optical_link"/>
  <joint name="lidar3d_optical_joint" type="fixed">
    <parent link="lidar3d_link"/>
    <child  link="lidar3d_optical_link"/>
    <origin xyz="0 0 ${lidar3d_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- Sensor en Gazebo referenciado al frame óptico -->
  <gazebo reference="lidar3d_optical_link">
    <sensor name="lidar3d_sensor" type="ray">
      <!-- Importante: no sumar más rotaciones/offsets aquí -->
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>false</visualize>       
      <update_rate>10</update_rate>    <!-- slam_toolbox.yaml -->

      <ray>
        <scan>
          <!-- 360° horizontal alrededor del eje del sensor -->
          <horizontal>
            <samples>1024</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159265359</min_angle>
            <max_angle> 3.14159265359</max_angle>
          </horizontal>

          <!-- 90° vertical SOLO hacia “arriba” (0 → +90°).
              Si tu convención de ejes estuviera invertida, usa [-1.5708, 0]. -->
          <vertical>
            <samples>64</samples>
            <resolution>1.0</resolution>
            <min_angle>0</min_angle>
            <max_angle>1.57079632679</max_angle> <!-- +90° -->
          </vertical>
        </scan>

        <!-- Rango de distancias -->
        <range>
          <min>0.10</min>     <!-- 10 cm -->
          <max>30.0</max>     <!-- ajusta a tu escenario/sensor -->
          <resolution>0.01</resolution>
        </range>

        <!-- Ruido  -->
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>

      <!-- Plugin ROS: publica sensor_msgs/PointCloud2 en /points con frame del óptico -->
      <plugin name="lidar3d_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/points</remapping>
        </ros>
        <frame_name>lidar3d_optical_link</frame_name>
        <output_type>sensor_msgs/PointCloud2</output_type>
      </plugin>
    </sensor>
  </gazebo>
  <!-- ===================== FIN LIDAR 4D – COMPLETO ===================== -->





<!-- ============== ULTRASONICO ADELANTE - SIIIIIIIIIIIIIIIIIIIIIIII ============== -->

  <xacro:property name="sonar_radius" value="0.02"/>
  <xacro:property name="sonar_len"    value="0.04"/>


 <link name="ultra_front_der_link">
   <visual>
     <origin xyz="0 0 0" rpy="0 0 0"/>
     <geometry><cylinder radius="${sonar_radius}" length="${sonar_len}"/></geometry>
     <material name="gray"><color rgba="0.3 0.3 0.3 1"/></material>
   </visual>
   <collision>
     <origin xyz="0 0 0" rpy="0 0 0"/>
     <geometry><cylinder radius="${sonar_radius}" length="${sonar_len}"/></geometry>
   </collision>
   <inertial>
     <mass value="0.03"/>
     <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
   </inertial>
 </link>



 <joint name="ultra_front_der_joint" type="fixed">
   <parent link="base_link"/>
   <child  link="ultra_front_der_link"/>
                                          <!-- 117 grados -->
  <origin xyz="-0.20 -0.26 0.0001" rpy="0 0 -2.04204"/>
 </joint>



 <gazebo reference="ultra_front_der_link">
   <sensor name="ultra_front_der_scan" type="ray">
     <always_on>true</always_on>
     <visualize>true</visualize>
     <update_rate>15</update_rate>


     <ray>
       <scan>
         <horizontal>
           <samples>61</samples>               <resolution>1.0</resolution>
           <min_angle>-0.523599</min_angle> <max_angle> 0.523599</max_angle> </horizontal>
         <vertical>
           <samples>1</samples>
           <resolution>1.0</resolution>
           <min_angle>0</min_angle>
           <max_angle>0</max_angle>
         </vertical>
       </scan>


       <range>
         <min>0.3</min>  <max>3.0</max>  <resolution>0.01</resolution>
       </range>
     </ray>


     <plugin name="ultra_front_der_plugin" filename="libgazebo_ros_ray_sensor.so">
       <ros>
         <namespace>/</namespace>
         <remapping>~/out:=/ultra_front_der</remapping>
       </ros>
       <frame_name>ultra_front_der_link</frame_name>
       <output_type>sensor_msgs/LaserScan</output_type>
     </plugin>
   </sensor>
 </gazebo>




  <link name="ultra_front_izq_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="${sonar_radius}" length="${sonar_len}"/></geometry>
      <material name="gray"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="${sonar_radius}" length="${sonar_len}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="ultra_front_izq_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="ultra_front_izq_link"/>

                                           <!-- 64 grados -->
    <origin xyz="0.20 -0.26 0.0001" rpy="0 0 -1.11701"/>
  </joint>

  <gazebo reference="ultra_front_izq_link">
    <sensor name="ultra_front_izq_scan" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>15</update_rate>

      <ray>
        <scan>
          <horizontal>
            <samples>61</samples>
            <resolution>1.0</resolution>
            <min_angle>-0.523599</min_angle>
            <max_angle> 0.523599</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1.0</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>

        <range>
          <min>0.3</min>
          <max>3.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>

      <plugin name="ultra_front_izq_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/ultra_front_izq</remapping>
        </ros>
        <frame_name>ultra_front_izq_link</frame_name>
        <output_type>sensor_msgs/LaserScan</output_type>
      </plugin>
    </sensor>
  </gazebo>


  <!-- ============== ULTRASONICO ATRAS  ============== -->

  <link name="ultra_atras_der_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="${sonar_radius}" length="${sonar_len}"/></geometry>
      <material name="gray"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="${sonar_radius}" length="${sonar_len}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="ultra_atras_der_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="ultra_atras_der_link"/>
                                            <!-- 63 grados -->
    <origin xyz="0.20 0.26 0.0001" rpy="0 0 1.09956"/>
  </joint>

  <gazebo reference="ultra_atras_der_link">
    <sensor name="ultra_atras_der_scan" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>15</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>61</samples>
            <resolution>1.0</resolution>
            <min_angle>-0.523599</min_angle>
            <max_angle> 0.523599</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1.0</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.3</min>
          <max>3.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="ultra_atras_der_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/ultra_atras_der</remapping>
        </ros>
        <frame_name>ultra_atras_der_link</frame_name>
        <output_type>sensor_msgs/LaserScan</output_type>
      </plugin>
    </sensor>
  </gazebo>

  <link name="ultra_atras_izq_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="${sonar_radius}" length="${sonar_len}"/></geometry>
      <material name="gray"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="${sonar_radius}" length="${sonar_len}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="ultra_atras_izq_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="ultra_atras_izq_link"/>
                                            <!-- 116 grados -->
    <origin xyz="-0.20 0.26 0.0001" rpy="0 0 2.02458"/>
  </joint>

  <gazebo reference="ultra_atras_izq_link">
    <sensor name="ultra_atras_izq_scan" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>15</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>61</samples>
            <resolution>1.0</resolution>
            <min_angle>-0.523599</min_angle>
            <max_angle> 0.523599</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1.0</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.3</min>
          <max>3.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="ultra_atras_izq_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/ultra_atras_izq</remapping>
        </ros>
        <frame_name>ultra_atras_izq_link</frame_name>
        <output_type>sensor_msgs/LaserScan</output_type>
      </plugin>
    </sensor>
  </gazebo>








  <!-- ============== Dif. Drive (Gazebo) ============== -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <left_joint>RuedaIzquierda_join</left_joint>
      <right_joint>RuedaDerecha_join</right_joint>
      <wheel_separation>0.416</wheel_separation>
      <wheel_diameter>0.26</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>
  <!-- ================================================ -->

</robot>
