<?xml version="1.0"?>
<robot name="cobot_arm">


  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.1" radius="0.2"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.1 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.1" radius="0.2"/>
      </geometry>
    </collision>
    <default_inertial mass="5.0"/> 
  </link>

  <joint name="arm_joint2" type="revolute">
    <parent link="base_link"/>
    <child link="arm_link2"/>
    <origin rpy="0 0 0" xyz="0 0 0.15"/> 
    <axis xyz="0 0 1"/> <limit effort="411" lower="-3.14" upper="3.14" velocity="1.57"/>
  </joint>

  <link name="arm_link2">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><sphere radius="0.1"/></geometry>
      <material name="red"><color rgba="0.8 0.1 0.1 1.0"/></material>
    </visual>
    <visual>
      <origin rpy="0 1.5708 0" xyz="0.325 0 0"/> 
      <geometry><cylinder length="0.65" radius="0.05"/></geometry> <material name="grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
    </visual>
    
    <collision>
      <origin rpy="0 1.5708 0" xyz="0.325 0 0"/>
      <geometry><cylinder length="0.65" radius="0.05"/></geometry>
    </collision>
    <default_inertial mass="2.0"/>
  </link>

  <joint name="arm_joint3" type="revolute">
    <parent link="arm_link2"/>
    <child link="arm_link3"/>
    <origin rpy="0 1.5708 0" xyz="0.65 0 0.1"/> 
    <axis xyz="1 0 0"/> <limit effort="411" lower="-3.14" upper="3.14" velocity="1.57"/>
  </joint>

  <link name="arm_link3">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><sphere radius="0.1"/></geometry>
      <material name="red"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.2"/> 
      <geometry><cylinder length="0.4" radius="0.05"/></geometry>
      <material name="grey"/>
    </visual>
    
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.2"/> 
      <geometry><cylinder length="0.4" radius="0.05"/></geometry>
    </collision>
    <default_inertial mass="1.0"/>
  </link>

</robot>